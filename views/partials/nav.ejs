<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href="/">🐦 Chirp</a>
    <nav class="nav">
      <% if (locals.currentUser) { %>
        <a href="/users">Users</a>
        <a href="/requests">Requests<% if (locals.pendingRequestCount > 0) { %> <span class="badge" aria-label="<%= pendingRequestCount %> pending"><%= pendingRequestCount %></span><% } %></a>
        <a class="nav__user" href="/users/<%= currentUser.username %>">@<%= currentUser.username %></a>
        <form method="post" action="/logout" class="inline-form">
          <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
          <button type="submit" class="btn btn--ghost">Log out</button>
        </form>
      <% } else { %>
        <a href="/login">Log in</a>
        <a href="/signup">Sign up</a>
      <% } %>
    </nav>
  </div>
</header>