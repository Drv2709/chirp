<%- include('../partials/head') %>
<h1>Users</h1>

<form method="get" action="/users" class="search" role="search">
  <label for="user-search" class="visually-hidden">Search users</label>
  <input
    id="user-search"
    class="search__input"
    type="search"
    name="q"
    value="<%= query %>"
    maxlength="50"
    placeholder="Search by name or username"
    autocomplete="off"
  >
  <button type="submit" class="btn">Search</button>
  <% if (query) { %>
    <a class="search__clear" href="/users">Clear</a>
  <% } %>
</form>

<% if (query) { %>
  <p class="muted search__summary">
    <%= users.length %> result<%= users.length === 1 ? '' : 's' %> for “<%= query %>”
  </p>
<% } %>

<% if (users.length === 0) { %>
  <p class="muted empty-state">
    <%= query ? 'No users match your search.' : 'No users yet.' %>
  </p>
<% } else { %>
  <ul class="user-list">
    <% users.forEach(function (person) { %>
      <li class="user-row">
        <div class="user-row__main">
          <a class="avatar-link" href="/users/<%= person.username %>" tabindex="-1" aria-hidden="true">
            <%- include('../partials/_avatar', { url: person.avatarUrl, size: 40 }) %>
          </a>
          <div class="user-row__info">
            <a class="post__author" href="/users/<%= person.username %>"><strong><%= person.displayName %></strong></a>
            <span class="muted">@<%= person.username %></span>
            <% if (person.bio) { %>
              <p class="user-row__bio"><%= person.bio %></p>
            <% } %>
          </div>
        </div>
        <div class="user-row__action">
          <%- include('../partials/_followButton', { person: person }) %>
        </div>
      </li>
    <% }) %>
  </ul>
<% } %>
<%- include('../partials/foot') %>