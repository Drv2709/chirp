<%- include('../partials/head') %>
<h1>Home</h1>

<%- include('../partials/composeForm') %>

<h2 class="section-title">Latest</h2>

<% if (posts.length === 0) { %>
  <p class="muted empty-state">Nothing here yet. Post something, or follow people to fill your feed.</p>
<% } else { %>
  <ul class="post-list">
    <% posts.forEach(function (post) { %>
      <li><%- include('../partials/_postCard', { post: post, detail: false }) %></li>
    <% }) %>
  </ul>

  <%- include('../partials/pagination') %>
<% } %>
<%- include('../partials/foot') %>