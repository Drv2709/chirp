<%- include('../partials/head') %>
<p><a href="/">← Back</a></p>

<article class="post post--detail">
  <div class="post__meta">
    <strong><%= post.author.displayName %></strong>
    <span class="muted">@<%= post.author.username %></span>
  </div>
  <p class="post__content post__content--large"><%= post.content %></p>
  <p class="muted">
    <%= new Date(post.createdAt).toLocaleString('en-US', { dateStyle: 'long', timeStyle: 'short' }) %>
  </p>

  <% if (currentUser && currentUser.id === post.author.id) { %>
    <form method="post" action="/posts/<%= post.id %>/delete" class="inline-form" onsubmit="return confirm('Delete this post?');">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="btn btn--danger">Delete</button>
    </form>
  <% } %>
</article>
<%- include('../partials/foot') %>