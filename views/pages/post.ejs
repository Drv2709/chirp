<%- include('../partials/head') %>
<p><a href="/">← Back</a></p>

<%- include('../partials/_postCard', { post: post, detail: true }) %>

<section id="comments" class="comments">
  <h2 class="section-title">Comments (<%= comments.length %>)</h2>

  <form method="post" action="/posts/<%= post.id %>/comments" class="form compose">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <% if (locals.error) { %>
      <p class="form-error" role="alert"><%= error %></p>
    <% } %>

    <label for="comment-content" class="visually-hidden">Write a comment</label>
    <textarea id="comment-content" name="content" rows="2" maxlength="280" placeholder="Write a comment…" required><%= locals.content || '' %></textarea>

    <div class="compose__actions">
      <span class="muted">Max 280 characters</span>
      <button type="submit" class="btn">Comment</button>
    </div>
  </form>

  <% if (comments.length === 0) { %>
    <p class="muted empty-state">No comments yet. Be the first.</p>
  <% } else { %>
    <ul class="comment-list">
      <% comments.forEach(function (comment) { %>
        <li class="comment" id="comment-<%= comment.id %>">
          <div class="post__meta">
            <strong><%= comment.author.displayName %></strong>
            <span class="muted">@<%= comment.author.username %></span>
            <span class="muted">·</span>
            <span class="muted">
              <%= new Date(comment.createdAt).toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' }) %>
            </span>
          </div>
          <p class="post__content"><%= comment.content %></p>
          <% if (currentUser && currentUser.id === comment.author.id) { %>
            <form method="post" action="/comments/<%= comment.id %>/delete" class="inline-form" onsubmit="return confirm('Delete this comment?');">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn btn--danger">Delete</button>
            </form>
          <% } %>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>
<%- include('../partials/foot') %>