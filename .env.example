NODE_ENV=development
PORT=3000

# Local Docker Postgres (matches docker-compose.yml; host port 5433 avoids clashing with a system Postgres)
DATABASE_URL="postgresql://chirp:chirp@localhost:5433/chirp?schema=public"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-me-with-a-long-random-string"